---
import "../styles/global.css";
import Header from "../components/Header.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | ${site.role}`, description = site.tagline } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark light" />
    <!-- Runs before the page paints so a saved light theme never flashes dark first. -->
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.classList.remove("dark");
        }
      } catch {}
    </script>
  </head>
  <body
    class="min-h-screen bg-white text-zinc-700 antialiased transition-colors dark:bg-zinc-950 dark:text-zinc-300"
  >
    <a
      href="#main"
      class="sr-only rounded-md bg-teal-700 px-4 py-2 font-medium text-white focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto max-w-3xl px-4 sm:px-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-4 py-10 text-sm text-zinc-500 sm:px-6">
      <p>&copy; {new Date().getFullYear()} {site.name}. Built with Astro and Tailwind CSS.</p>
    </footer>
  </body>
</html>
