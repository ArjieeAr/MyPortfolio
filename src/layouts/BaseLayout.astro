---
import "../styles/global.css";
import Header from "../components/Header.astro";
import site from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | ${site.role}`, description = site.tagline } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark light" />
    <!-- Inter Tight is the closest free match to the design's typeface (Mori). -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;600&display=swap" rel="stylesheet" />
    <!-- Runs before the page paints so a saved light theme never flashes dark first. -->
    <!-- It also marks that JavaScript is on, which lets scroll-reveal content start hidden. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.classList.remove("dark");
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen bg-canvas tracking-[-0.01em] text-ink antialiased transition-colors">
    <a
      href="#main"
      class="sr-only rounded-full bg-accent px-5 py-2 font-semibold text-canvas focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
    >
      Skip to content
    </a>
    <Header />
    <!-- overflow-x-clip: the hero's name drifts sideways on scroll; this stops it widening the page. -->
    <main id="main" class="overflow-x-clip">
      <div class="mx-auto max-w-7xl px-4 sm:px-8">
        <slot />
      </div>
    </main>
    <footer class="border-t border-line">
      <div class="mx-auto max-w-7xl px-4 py-10 text-muted sm:px-8">
        <p>&copy; {new Date().getFullYear()} {site.name}. Built with Astro and Tailwind CSS.</p>
      </div>
    </footer>
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
