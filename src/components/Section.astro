---
import Annotation from "./Annotation.astro";

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<!-- On large screens the heading sits in a narrow left column and the content fills the rest. -->
<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class="border-t border-line py-20 lg:grid lg:grid-cols-[14rem_1fr] lg:gap-12 lg:py-28"
>
  <h2 id={`${id}-heading`} class="mb-10 text-lg text-accent lg:mb-0">
    <Annotation>{title}</Annotation>
  </h2>
  <div>
    <slot />
  </div>
</section>
