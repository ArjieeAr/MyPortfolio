---
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const linkClass =
  "font-medium text-teal-700 underline-offset-4 hover:underline dark:text-teal-400";
---

<article class="rounded-lg border border-zinc-200 p-6 transition-colors hover:border-teal-700/50 dark:border-zinc-800 dark:hover:border-teal-400/50">
  <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">{project.title}</h3>
  <p class="mt-3 leading-relaxed">{project.description}</p>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies used">
    {project.tech.map((tech) => <li class="rounded bg-zinc-100 px-2 py-0.5 text-sm dark:bg-zinc-800/70">{tech}</li>)}
  </ul>
  {
    (project.live || project.repo) && (
      <div class="mt-5 flex flex-wrap gap-5 text-sm">
        {project.live && (
          <a href={project.live} class={linkClass} aria-label={`Live site for ${project.title}`}>
            Live site &rarr;
          </a>
        )}
        {project.repo && (
          <a href={project.repo} class={linkClass} aria-label={`Source code for ${project.title}`}>
            Source code &rarr;
          </a>
        )}
      </div>
    )
  }
</article>
