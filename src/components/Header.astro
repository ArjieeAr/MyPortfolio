---
import ThemeToggle from "./ThemeToggle.astro";
import site from "../data/site.json";
import { projects } from "../lib/projects";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();

// Only link to sections that are actually shown on the page. Contact is a separate pill button.
const links = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  projects.length > 0 && { href: "/#projects", label: "Projects" },
  posts.length > 0 && { href: "/#blog", label: "Blog" },
].filter((link) => link !== false);
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-10 gap-y-3 px-4 py-4 sm:px-8">
    <a href="/" class="text-lg font-semibold tracking-[-0.011em] text-ink">{site.name}</a>
    <nav aria-label="Main" class="order-last w-full sm:order-none sm:w-auto">
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-ink/75 transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <ThemeToggle />
      <a href="/#contact" class="btn btn-sm">Contact</a>
    </div>
  </div>
</header>
