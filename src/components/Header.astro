---
import ThemeToggle from "./ThemeToggle.astro";
import site from "../data/site.json";
import { projects } from "../lib/projects";
import { getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();

// Only link to sections that are actually shown on the page.
const links = [
  { href: "/#about", label: "About" },
  { href: "/#skills", label: "Skills" },
  projects.length > 0 && { href: "/#projects", label: "Projects" },
  posts.length > 0 && { href: "/#blog", label: "Blog" },
  { href: "/#contact", label: "Contact" },
].filter((link) => link !== false);
---

<header
  class="sticky top-0 z-40 border-b border-zinc-200 bg-white/85 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/85"
>
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
    <a href="/" class="font-semibold text-zinc-900 dark:text-zinc-100">{site.name}</a>
    <nav aria-label="Main" class="order-last w-full sm:order-none sm:ml-auto sm:w-auto">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-zinc-600 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-400"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
