---
import Section from "./Section.astro";
import site from "../data/site.json";

// Each group gets its own highlighter colour, like the design's colour-coded category labels.
const groupColors = ["text-hl-orange", "text-hl-pink", "text-hl-lilac", "text-hl-blue"];
---

<Section id="skills" title="Skills">
  <div class="divide-y divide-line">
    {
      site.skills.map((group, i) => (
        <div class="grid gap-4 py-6 first:pt-0 last:pb-0 sm:grid-cols-[13rem_1fr] sm:gap-8">
          <h3 class:list={["text-lg font-semibold", groupColors[i % groupColors.length]]}>{group.group}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <li class="rounded-lg border border-line px-3 py-1.5 text-ink/90">{skill}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
