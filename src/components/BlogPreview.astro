---
import Section from "./Section.astro";
import PostList from "./PostList.astro";
import { getPublishedPosts } from "../lib/posts";

const LATEST_COUNT = 3;
const posts = await getPublishedPosts();
---

{/* The whole section is hidden when there are no published posts. */}
{
  posts.length > 0 && (
    <Section id="blog" title="Latest Posts">
      <PostList posts={posts.slice(0, LATEST_COUNT)} />
      <div class="mt-10" data-reveal>
        <a href="/blog/" class="btn btn-sm">
          All posts <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Section>
  )
}
