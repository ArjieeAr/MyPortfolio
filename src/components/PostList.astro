---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ul class="divide-y divide-line">
  {
    posts.map((post) => (
      <li class="py-6 first:pt-0 last:pb-0">
        <article class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-8">
          <time datetime={post.data.pubDate.toISOString()} class="text-muted sm:pt-1.5">
            {formatDate(post.data.pubDate)}
          </time>
          <div>
            <h3 class="text-2xl font-semibold tracking-[-0.011em]">
              <a href={`/blog/${post.id}/`} class="text-ink transition-colors hover:text-accent">
                {post.data.title}
              </a>
            </h3>
            <p class="mt-2 text-lg leading-relaxed text-ink/75">{post.data.description}</p>
          </div>
        </article>
      </li>
    ))
  }
</ul>
