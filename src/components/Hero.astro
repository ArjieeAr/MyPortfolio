---
import Annotation from "./Annotation.astro";
import site from "../data/site.json";
import { projects } from "../lib/projects";

// The last word of the name gets its own line, pushed right like the design's hero headline.
const words = site.name.split(" ");
const lastWord = words.pop();
const firstWords = words.join(" ");
---

<section aria-labelledby="hero-heading" class="pt-14 pb-20 sm:pt-20 sm:pb-28">
  <p class="text-lg text-accent"><Annotation>{site.role}</Annotation></p>
  <h1
    id="hero-heading"
    class="mt-8 text-[clamp(3.5rem,15vw,14rem)] leading-[0.9] font-semibold tracking-[-0.02em] text-ink"
  >
    {firstWords && <span class="block">{firstWords} </span>}
    <span class="block sm:text-right">{lastWord}.</span>
  </h1>
  <div class="mt-12 flex flex-col gap-8 sm:mt-16 sm:flex-row sm:items-end sm:justify-between">
    <p class="max-w-md text-lg leading-snug"><Annotation>{site.tagline}</Annotation></p>
    <div class="flex flex-wrap gap-3">
      {
        projects.length > 0 && (
          <a href="#projects" class="btn btn-primary">
            View my work
          </a>
        )
      }
      <a href="#contact" class="btn">Get in touch</a>
    </div>
  </div>
</section>
