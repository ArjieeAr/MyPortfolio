---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Annotation from "../../components/Annotation.astro";
import site from "../../data/site.json";
import { formatDate, getPublishedPosts } from "../../lib/posts";

// Builds one page per published post. The file name becomes the URL: my-post.md -> /blog/my-post/
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | ${site.name}`} description={post.data.description}>
  <article class="max-w-3xl py-16 sm:py-24">
    <a href="/blog/" class="btn btn-sm">
      <span class="btn-arrow btn-arrow-back" aria-hidden="true">&larr;</span> All posts
    </a>
    <header class="mt-10 mb-12">
      <h1 class="intro text-4xl leading-[1.05] font-semibold tracking-[-0.02em] text-ink sm:text-6xl">
        {post.data.title}
      </h1>
      <time datetime={post.data.pubDate.toISOString()} class="intro mt-6 block text-accent" style="--delay: 150ms">
        <Annotation>{formatDate(post.data.pubDate)}</Annotation>
      </time>
    </header>
    <div class="post-body text-lg text-ink/80">
      <Content />
    </div>
  </article>
</BaseLayout>
