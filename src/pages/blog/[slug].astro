---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import site from "../../data/site.json";
import { formatDate, getPublishedPosts } from "../../lib/posts";

// Builds one page per published post. The file name becomes the URL: my-post.md -> /blog/my-post/
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | ${site.name}`} description={post.data.description}>
  <article class="py-16">
    <a href="/blog/" class="text-sm font-medium text-teal-700 underline-offset-4 hover:underline dark:text-teal-400">
      &larr; All posts
    </a>
    <header class="mt-8 mb-10">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()} class="mt-3 block text-sm text-zinc-500">
        {formatDate(post.data.pubDate)}
      </time>
    </header>
    <div class="post-body text-lg">
      <Content />
    </div>
  </article>
</BaseLayout>
