---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import site from "../../data/site.json";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout title={`Blog | ${site.name}`} description={`Posts by ${site.name}.`}>
  <section aria-labelledby="blog-heading" class="py-16">
    <h1 id="blog-heading" class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Blog</h1>
    <p class="mt-4 mb-12 text-lg">Notes on what I'm building and learning.</p>
    {posts.length > 0 ? <PostList posts={posts} /> : <p>No posts yet. Check back soon.</p>}
  </section>
</BaseLayout>
